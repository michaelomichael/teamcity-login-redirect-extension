{
  "manifest_version": 3,
  "name": "TeamGoldfish: TeamCity Redirect Extension",
  "version": "0.1",
  "description": "Return to the original TeamCity URL after authorisation is complete",

  "permissions": [
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://teamcity.bmtapps.bskyb.com/*"
  ],
  "background": {
    "service_worker": "scripts/worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}